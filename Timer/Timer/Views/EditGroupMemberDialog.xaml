<Window x:Class="Timer.Views.EditGroupMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑成员" Height="320" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 芯片标签号码 -->
        <StackPanel Grid.Row="0" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="芯片标签号码" Style="{StaticResource FormLabelStyle}"/>
            <ComboBox ItemsSource="{Binding AvailableChips}" 
                      SelectedValue="{Binding ChipLabelNumber}" 
                      SelectedValuePath="LabelNumber"
                      DisplayMemberPath="LabelNumber"
                      Style="{StaticResource FormComboBoxStyle}"/>
        </StackPanel>

        <!-- 芯片内部号码 -->
        <StackPanel Grid.Row="1" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="芯片内部号码" Style="{StaticResource FormLabelStyle}"/>
            <TextBox Text="{Binding ChipInternalNumber, Mode=OneWay}" 
                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
        </StackPanel>

        <!-- 按钮区 -->
        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonPanelStyle}">
            <Button Content="取消" Command="{Binding CancelCommand}" 
                    Style="{StaticResource DialogCancelButtonStyle}"/>
            <Button Content="保存" Command="{Binding SaveCommand}" 
                    Style="{StaticResource DialogSaveButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
