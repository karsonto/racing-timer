<UserControl x:Class="Timer.Views.ChipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- 主内容区域 -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- 上半部分：芯片组列表区域 -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 标题栏：左侧显示标题，右侧显示导入按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="所有芯片组列表"
                               FontSize="14"
                               Foreground="{StaticResource TextColorBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="📥 导入芯片信息"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- 芯片组列表表格 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ChipGroups}"
                          SelectedItem="{Binding SelectedChipGroup, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          RowHeight="40"
                          ColumnHeaderHeight="40">
                    <!-- 单元格样式：垂直居中，左对齐 -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <!-- 表头样式：左对齐，垂直居中 -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- 选择列 (单选框) -->
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="ChipGroupSelection"
                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 组名 -->
                        <DataGridTextColumn Header="组名" 
                                            Binding="{Binding GroupName}" 
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 组颜色 -->
                        <DataGridTemplateColumn Header="组颜色" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Rectangle Width="40" 
                                               Height="22"
                                               RadiusX="3"
                                               RadiusY="3"
                                               HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <Binding Path="Color" Converter="{StaticResource HexColorToBrushConverter}"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 数量 -->
                        <DataGridTextColumn Header="数量" 
                                            Binding="{Binding ChipCount}" 
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Button Content="编辑" 
                                                Style="{StaticResource TableEditButtonStyle}"
                                                Command="{Binding DataContext.EditChipGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="删除" 
                                                Style="{StaticResource TableDeleteButtonStyle}"
                                                Command="{Binding DataContext.DeleteChipGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- 空状态提示 - 当没有芯片组时显示 -->
                <Border Grid.Row="1"
                        Visibility="{Binding ChipGroups.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="暂无芯片组，请导入芯片信息"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextColorBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 下半部分：芯片详情区域 -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 标题 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="芯片组详情"
                                   FontSize="14"
                                   Foreground="{StaticResource TextColorBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0ea5e9"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SelectedChipGroup, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock.Text>
                                <Binding Path="SelectedChipGroup.GroupName" StringFormat=" ({0})"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 芯片详情表格 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Chips}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          RowHeight="40"
                          ColumnHeaderHeight="40"
                          Visibility="{Binding SelectedChipGroup, Converter={StaticResource NullToVisibilityConverter}}">
                    <!-- 单元格样式：垂直居中，左对齐 -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <!-- 表头样式：左对齐，垂直居中 -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- 芯片标签号码 -->
                        <DataGridTextColumn Header="芯片标签号码" 
                                            Binding="{Binding LabelNumber}" 
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 芯片内部号码 -->
                        <DataGridTextColumn Header="芯片内部号码" 
                                            Binding="{Binding InternalNumber}" 
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Button Content="编辑" 
                                                Style="{StaticResource TableEditButtonStyle}"
                                                Command="{Binding DataContext.EditChipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="删除" 
                                                Style="{StaticResource TableDeleteButtonStyle}"
                                                Command="{Binding DataContext.DeleteChipCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- 未选择提示 -->
                <TextBlock Grid.Row="1"
                           Text="请选择上方芯片组查看详情" 
                           FontSize="14" 
                           Foreground="{StaticResource SecondaryTextColorBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding SelectedChipGroup, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>
        </Border>
        </Grid>

        <!-- 加载遮罩层 -->
        <Border Background="#80000000" 
                Panel.ZIndex="1000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="32,24"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="处理中..." 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextColorBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请稍候" 
                               FontSize="12" 
                               Foreground="{StaticResource SecondaryTextColorBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
