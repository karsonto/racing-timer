<Window x:Class="Timer.Views.EditParticipantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Timer.Converters"
        Title="编辑参赛人员信息"
        Width="600"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="编辑参赛人员信息" Style="{StaticResource DialogTitleStyle}"/>

        <!-- 表单区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 比赛日期 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="比赛日期 *" Style="{StaticResource FormLabelGridStyle}"/>
                <DatePicker Grid.Row="0" Grid.Column="1"
                            SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FormDatePickerStyle}"/>

                <!-- 学校 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="学校" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding School, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 年级 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="年级" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 班级 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="班级" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Class, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 姓名 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="姓名 *" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 性别 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="性别 *" Style="{StaticResource FormLabelGridStyle}"/>
                <ComboBox Grid.Row="5" Grid.Column="1"
                          ItemsSource="{Binding GenderOptions}"
                          SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                          Height="36"
                          Margin="0,0,0,12"/>

                <!-- 准考证号 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="准考证号" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding ExamNumber, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 组别 -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="组别" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="7" Grid.Column="1"
                         Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 号码布 -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="号码布" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="8" Grid.Column="1"
                         Text="{Binding BibNumber, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <!-- 芯片编号 -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="芯片编号" Style="{StaticResource FormLabelGridStyle}"/>
                <TextBox Grid.Row="9" Grid.Column="1"
                         Text="{Binding ChipNumber, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"/>
            </Grid>
        </ScrollViewer>

        <!-- 错误提示 -->
        <Border Grid.Row="2"
                Style="{StaticResource ValidationErrorBorderStyle}"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Style="{StaticResource ValidationErrorTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding ValidationErrors}"
                              ItemTemplate="{StaticResource ValidationErrorTemplate}"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonPanelStyle}">
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Style="{StaticResource DialogCancelButtonStyle}"
                    Padding="24,8"/>
            <Button Content="保存"
                    Click="SaveButton_Click"
                    Style="{StaticResource DialogSaveButtonStyle}"
                    Padding="24,8"/>
        </StackPanel>
    </Grid>
</Window>
