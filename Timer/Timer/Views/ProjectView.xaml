<UserControl x:Class="Timer.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- 统一的 ComboBox 样式：选项文字左对齐 -->
        <Style x:Key="CenteredComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        
        <!-- DatePicker 样式：内容居中 -->
        <Style x:Key="CenteredDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- 主内容区域 -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部查询区 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="查询条件" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextColorBrush}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="开始日期：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" 
                                Style="{StaticResource CenteredDatePickerStyle}" Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="2" Text="结束日期：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" 
                                Style="{StaticResource CenteredDatePickerStyle}" Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="4" Text="项目：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding ProjectNames}" 
                              SelectedItem="{Binding SelectedProject}" Style="{StaticResource CenteredComboBoxStyle}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="查询" Command="{Binding SearchCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Width="120" Margin="0,0,12,0"/>
                    <Button Content="新增项目" Command="{Binding AddCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Width="120" Background="#22c55e" BorderBrush="#22c55e"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 数据表格卡片 -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}"
                Padding="16">
            <StackPanel>
                <!-- 顶部：记录数 + 批量操作 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding TotalCount, StringFormat='共找到 {0} 条记录'}"
                               FontSize="14"
                               Foreground="{StaticResource TextColorBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="删除所选"
                                Command="{Binding BatchDeleteCommand}"
                                Padding="16,8"
                                FontSize="12"
                                Background="#ff4d4f"
                                Foreground="White"
                                BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- 数据表格 -->
                <DataGrid ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProjectItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Height="500"
                          RowHeight="40"
                          ColumnHeaderHeight="40">
                    <!-- 单元格样式：垂直居中，左对齐 -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <!-- 表头样式：左对齐，垂直居中 -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="项目日期" Binding="{Binding ProjectDate, StringFormat=yyyy-MM-dd}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="项目名称" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="项目状态" Binding="{Binding StatusText}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Button Content="编辑"
                                                Style="{StaticResource TableEditButtonStyle}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="删除"
                                                Style="{StaticResource TableDeleteButtonStyle}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        </Grid>

        <!-- 加载遮罩层 -->
        <Border Background="#80000000" 
                Panel.ZIndex="1000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="32,24"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="处理中..." 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextColorBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请稍候" 
                               FontSize="12" 
                               Foreground="{StaticResource SecondaryTextColorBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
