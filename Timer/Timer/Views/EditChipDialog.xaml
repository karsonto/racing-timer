<Window x:Class="Timer.Views.EditChipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Timer.Converters"
        Title="编辑芯片"
        Width="450"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="编辑芯片" Style="{StaticResource DialogTitleStyle}"/>

        <!-- 表单区域 -->
        <StackPanel Grid.Row="1">
            <!-- 芯片标签号码 -->
            <StackPanel Style="{StaticResource FormFieldLargeStyle}">
                <TextBlock Text="芯片标签号码 *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding LabelNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"/>
            </StackPanel>

            <!-- 芯片内部编号 -->
            <StackPanel Style="{StaticResource FormFieldLargeStyle}">
                <TextBlock Text="芯片内部编号 *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding InternalNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <!-- 错误提示 -->
        <Border Grid.Row="2"
                Style="{StaticResource ValidationErrorBorderStyle}"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Style="{StaticResource ValidationErrorTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding ValidationErrors}"
                              ItemTemplate="{StaticResource ValidationErrorTemplate}"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonPanelStyle}">
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Style="{StaticResource DialogCancelButtonStyle}"
                    Padding="24,8"/>
            <Button Content="保存"
                    Click="SaveButton_Click"
                    Style="{StaticResource DialogSaveButtonStyle}"
                    Padding="24,8"/>
        </StackPanel>
    </Grid>
</Window>
