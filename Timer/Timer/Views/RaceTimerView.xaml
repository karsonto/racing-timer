<UserControl x:Class="Timer.Views.RaceTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter" MaxWidth="120"/>
        
        <!-- 反转布尔到可见性转换器 -->
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" IsInverted="True"/>
        
        <!-- 展开/折叠按钮样式 -->
        <Style x:Key="ExpanderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="4">
                            <Path x:Name="Arrow"
                                  Fill="#64748b"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 6 5 L 0 10 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ArrowRotation" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 状态标签样式 -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        
        <!-- 小型操作按钮 -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" 
                                                  BlurRadius="4" 
                                                  Opacity="0.3" 
                                                  Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" 
                                                          BlurRadius="2" 
                                                          Opacity="0.2" 
                                                          Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="36" Height="36" 
                            CornerRadius="8" 
                            Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366f1" Offset="0"/>
                                <GradientStop Color="#8b5cf6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⏱️" 
                                   FontSize="18" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="多组并行计时" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextColorBrush}"/>
                        <TextBlock Text="选择分组添加到比赛列表，支持多组同时计时" 
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextColorBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 标题栏右侧：添加比赛组 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="➕ 添加比赛组:" 
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextColorBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!-- 分组选择下拉框 -->
                    <ComboBox ItemsSource="{Binding AvailableRaceGroups}"
                              SelectedItem="{Binding SelectedAvailableGroup}"
                              DisplayMemberPath="DisplayName"
                              Height="32"
                              MinWidth="260"
                              Margin="0,0,10,0"/>

                    <!-- 添加按钮 -->
                    <Button Content="添加到比赛"
                            Command="{Binding AddGroupToRaceCommand}"
                            Background="#22c55e"
                            Foreground="White"
                            Height="32"
                            Padding="16,0"
                            Style="{StaticResource SmallActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载指示器 -->
        <Border Grid.Row="1"
                Background="#fffbeb"
                BorderBrush="#fde68a"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳" FontSize="16" Margin="0,0,8,0"/>
                <TextBlock Text="正在加载..." 
                           FontSize="14"
                           Foreground="#92400e"/>
            </StackPanel>
        </Border>

        <!-- 空状态提示 -->
        <Border Grid.Row="1"
                Visibility="{Binding HasRaceGroups, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="暂无比赛分组" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextColorBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="请在上方选择分组并点击【添加到比赛】" 
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextColorBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 比赛分组列表 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRaceGroups, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding RaceGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,12"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 分组头部 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 左侧芯片组颜色条 -->
                                    <Border Grid.Column="0"
                                            Background="{Binding ChipGroupColor, Converter={StaticResource HexColorToBrushConverter}}"
                                            CornerRadius="4,0,0,4"/>
                                    
                                    <Border Grid.Column="1" 
                                            Padding="16"
                                            BorderBrush="{StaticResource BorderColorBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 展开按钮 -->
                                            <StackPanel Grid.Column="0" 
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="4">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" 
                                                                Background="{TemplateBinding Background}" 
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <Path x:Name="Arrow"
                                                                  Fill="#64748b"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 0 0 L 6 5 L 0 10 Z"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform Angle="0"/>
                                                                </Path.RenderTransform>
                                                            </Path>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#f1f5f9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Button.RenderTransform>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <!-- 分组信息 -->
                                            <StackPanel Grid.Column="1" 
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" 
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextColorBrush}"/>
                                                <TextBlock FontSize="12" 
                                                           Foreground="{StaticResource SecondaryTextColorBrush}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="芯片组:"/>
                                                    <Run Text="{Binding ChipGroupName}" FontWeight="Medium"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding ParticipantCount}"/>
                                                    <Run Text="人 ·"/>
                                                    <Run Text="{Binding TotalLaps}"/>
                                                    <Run Text="圈"/>
                                                </TextBlock>
                                            </StackPanel>

                                        <!-- 计时器显示 + 状态标签 -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="20,0">
                                            <Border Padding="16,8"
                                                    CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#f1f5f9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="#dcfce7" Offset="0"/>
                                                                            <GradientStop Color="#d1fae5" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                <Setter Property="Background" Value="#fef3c7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ElapsedTimeDisplay}" 
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748b"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Foreground" Value="#16a34a"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                    <Setter Property="Foreground" Value="#d97706"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <!-- 状态标签（徽章样式） -->
                                            <Border CornerRadius="12"
                                                    Padding="12,4"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding StatusColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                    Opacity="0.9">
                                                <TextBlock Text="{Binding StatusText}" 
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- 操作按钮 -->
                                        <StackPanel Grid.Column="3" 
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- 开始按钮 -->
                                            <Button Command="{Binding DataContext.StartSingleRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#22c55e"
                                                    Foreground="White"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Padding="16,8"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}">
                                                <TextBlock Text="▶ 开始" FontSize="24" FontWeight="Bold"/>
                                            </Button>
                                            
                                            <!-- 暂停按钮 -->
                                            <Button Command="{Binding DataContext.PauseSingleRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#f59e0b"
                                                    Foreground="White"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Padding="16,8"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}">
                                                <TextBlock Text="⏸ 暂停" FontSize="24" FontWeight="Bold"/>
                                            </Button>
                                            
                                            <!-- 继续按钮 -->
                                            <Button Command="{Binding DataContext.ResumeSingleRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#3b82f6"
                                                    Foreground="White"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Padding="16,8"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}">
                                                <TextBlock Text="▶ 继续" FontSize="24" FontWeight="Bold"/>
                                            </Button>
                                            
                                            <!-- 重跑按钮 -->
                                            <Button Command="{Binding DataContext.StopSingleRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#ef4444"
                                                    Foreground="White"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Padding="16,8"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}">
                                                <TextBlock Text="⏹ 重跑" FontSize="24" FontWeight="Bold"/>
                                            </Button>

                                            <!-- 移除按钮（仅当比赛未开始时显示） -->
                                            <Button Command="{Binding DataContext.RemoveGroupFromRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#94a3b8"
                                                    Foreground="White"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    Padding="16,8"
                                                    ToolTip="从列表移除"
                                                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource SmallActionButton}">
                                                <TextBlock Text="✕ 移除" FontSize="24" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 展开的参赛者列表 -->
                                <Border Grid.Row="1"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#fafafa"
                                        Padding="16">
                                    <!-- 参赛者表格 -->
                                    <DataGrid ItemsSource="{Binding Participants}"
                                              AutoGenerateColumns="False"
                                              CanUserSortColumns="True"
                                              CanUserReorderColumns="False"
                                              CanUserResizeColumns="True"
                                              MaxHeight="300"
                                              RowHeight="40"
                                              ColumnHeaderHeight="40"
                                              BorderThickness="1"
                                              BorderBrush="{StaticResource BorderColorBrush}">
                                        <!-- 单元格样式：垂直居中，左对齐 -->
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Grid Background="{TemplateBinding Background}">
                                                                <ContentPresenter VerticalAlignment="Center" Margin="4,0"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <!-- 表头样式：左对齐，垂直居中 -->
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                                <!-- 排名 -->
                                                <DataGridTextColumn Header="排名" 
                                                                    Binding="{Binding Rank}" 
                                                                    Width="60"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="#6366f1"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 芯片外部号码 -->
                                                <DataGridTextColumn Header="芯片外部号码" 
                                                                    Binding="{Binding BibNumber}" 
                                                                    Width="100"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 姓名 -->
                                                <DataGridTextColumn Header="姓名" 
                                                                    Binding="{Binding Name}" 
                                                                    Width="90"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 当前圈数 -->
                                                <DataGridTextColumn Header="圈数" 
                                                                    Binding="{Binding CurrentLap}" 
                                                                    Width="60"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 累计用时 -->
                                                <DataGridTextColumn Header="累计用时" 
                                                                    Binding="{Binding TotalTimeFormatted}" 
                                                                    Width="110"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                            <Setter Property="FontFamily" Value="Consolas"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 最后一圈 -->
                                                <DataGridTextColumn Header="末圈" 
                                                                    Binding="{Binding LastLapTimeFormatted}" 
                                                                    Width="110"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                            <Setter Property="FontFamily" Value="Consolas"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColorBrush}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 全部圈次成绩 -->
                                                <DataGridTextColumn Header="各圈成绩" 
                                                                    Binding="{Binding AllLapsFormatted}" 
                                                                    Width="*"
                                                                    MinWidth="180"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                            <Setter Property="FontFamily" Value="Consolas"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColorBrush}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- 状态 -->
                                                <DataGridTextColumn Header="状态" 
                                                                    Binding="{Binding Status}" 
                                                                    Width="70"
                                                                    IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="TextAlignment" Value="Left"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#94a3b8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="进行中">
                                                                    <Setter Property="Foreground" Value="#22c55e"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="已完成">
                                                                    <Setter Property="Foreground" Value="#3b82f6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>

                                            <!-- 行样式：高亮领先者和已完成者 -->
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLeading}" Value="True">
                                                            <Setter Property="Background" Value="#fef3c7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
