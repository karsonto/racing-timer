<Window x:Class="Timer.Views.EditChipGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Timer.Converters"
        Title="编辑芯片组"
        Width="450"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="编辑芯片组" Style="{StaticResource DialogTitleStyle}"/>

        <!-- 表单区域 -->
        <StackPanel Grid.Row="1">
            <!-- 芯片组名称 -->
            <StackPanel Style="{StaticResource FormFieldLargeStyle}">
                <TextBlock Text="芯片组名称 *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"/>
            </StackPanel>

            <!-- 芯片组颜色 -->
            <StackPanel Style="{StaticResource FormFieldLargeStyle}">
                <TextBlock Text="芯片组颜色 *" Style="{StaticResource FormLabelStyle}"/>
                <ComboBox ItemsSource="{Binding PredefinedColors}"
                          SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource FormComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="24" 
                                           Height="24" 
                                           RadiusX="4" 
                                           RadiusY="4"
                                           Margin="0,0,10,0">
                                    <Rectangle.Fill>
                                        <Binding Path="HexColor" Converter="{StaticResource HexColorToBrushConverter}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="{Binding Name}" 
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- 颜色预览 -->
            <StackPanel Style="{StaticResource FormFieldStyle}">
                <TextBlock Text="颜色预览" Style="{StaticResource FormLabelStyle}"/>
                <Border Width="100" 
                        Height="40" 
                        CornerRadius="4"
                        HorizontalAlignment="Left">
                    <Border.Background>
                        <Binding Path="SelectedColor.HexColor" Converter="{StaticResource HexColorToBrushConverter}"/>
                    </Border.Background>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 错误提示 -->
        <Border Grid.Row="2"
                Style="{StaticResource ValidationErrorBorderStyle}"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Style="{StaticResource ValidationErrorTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding ValidationErrors}"
                              ItemTemplate="{StaticResource ValidationErrorTemplate}"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonPanelStyle}">
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Style="{StaticResource DialogCancelButtonStyle}"
                    Padding="24,8"/>
            <Button Content="保存"
                    Click="SaveButton_Click"
                    Style="{StaticResource DialogSaveButtonStyle}"
                    Padding="24,8"/>
        </StackPanel>
    </Grid>
</Window>
