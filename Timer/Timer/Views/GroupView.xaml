<UserControl x:Class="Timer.Views.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Timer.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- DatePicker 样式：内容居中 -->
        <Style x:Key="CenteredDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- ComboBox 样式 -->
        <Style x:Key="CenteredComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 主内容区域 -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部查询区 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="查询条件" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextColorBrush}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="开始日期：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StartDate}" 
                                Style="{StaticResource CenteredDatePickerStyle}" Margin="0,0,16,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="结束日期：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding EndDate}" 
                                Style="{StaticResource CenteredDatePickerStyle}" Margin="0,0,16,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="学校：" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding Schools}" 
                              SelectedItem="{Binding SelectedSchool}" Style="{StaticResource CenteredComboBoxStyle}"/>

                    <!-- 第二行 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="年级：" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Grades}" 
                              SelectedItem="{Binding SelectedGrade}" Style="{StaticResource CenteredComboBoxStyle}" Margin="0,12,16,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="班级：" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Classes}" 
                              SelectedItem="{Binding SelectedClass}" Style="{StaticResource CenteredComboBoxStyle}" Margin="0,12,16,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="组别：" VerticalAlignment="Center" Margin="0,12,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding Groups}" 
                              SelectedItem="{Binding SelectedGroup}" Style="{StaticResource CenteredComboBoxStyle}" Margin="0,12,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="查询" Command="{Binding QueryCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Width="120" Margin="0,0,12,0"/>
                    <Button Content="导出分组结果" Command="{Binding ExportCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Width="140" Background="#22c55e" BorderBrush="#22c55e"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 中间分组列表 DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 标题栏 -->
                <TextBlock Grid.Row="0"
                           Text="分组列表"
                           FontSize="14"
                           Foreground="{StaticResource TextColorBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,12"/>
                
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RaceGroups}" 
                          SelectedItem="{Binding SelectedRaceGroup}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column" 
                          GridLinesVisibility="None"
                          SelectionMode="Single"
                          RowHeight="40"
                          ColumnHeaderHeight="40">
                    <!-- 单元格样式：垂直居中，左对齐 -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <!-- 表头样式：左对齐，垂直居中 -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- 选择列 (单选框) -->
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="RaceGroupSelection"
                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="学校" Binding="{Binding School}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="年级" Binding="{Binding Grade}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="班级" Binding="{Binding Class}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="组别" Binding="{Binding GroupName}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 芯片组列（带颜色块） -->
                        <DataGridTemplateColumn Header="芯片组" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Rectangle Width="16" Height="16" 
                                                   Fill="{Binding ChipGroupColor, Converter={StaticResource HexColorToBrushConverter}}" 
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChipGroupName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="人员数量" Binding="{Binding ParticipantCount}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="圈数" Binding="{Binding RaceLaps}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button Content="编辑" 
                                                Command="{Binding DataContext.EditRaceGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditButtonStyle}" 
                                                Margin="0,0,8,0"/>
                                        <Button Content="删除" 
                                                Command="{Binding DataContext.DeleteRaceGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 底部人员详情 DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 标题 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="分组详情"
                                   FontSize="14"
                                   Foreground="{StaticResource TextColorBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0ea5e9"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SelectedRaceGroup, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat=" ({0} - {1})">
                                    <Binding Path="SelectedRaceGroup.GroupName"/>
                                    <Binding Path="SelectedRaceGroup.ChipGroupName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 人员列表 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Participants}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column" 
                          GridLinesVisibility="None"
                          RowHeight="40"
                          ColumnHeaderHeight="40"
                          Visibility="{Binding SelectedRaceGroup, Converter={StaticResource NullToVisibilityConverter}}">
                    <!-- 单元格样式：垂直居中，左对齐 -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" Margin="4,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <!-- 表头样式：左对齐，垂直居中 -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="组内序号" Binding="{Binding GroupSequenceNumber}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="准考证号" Binding="{Binding ExamNumber}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="芯片标签号码" Binding="{Binding ChipNumber}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="芯片内部号码" Binding="{Binding ChipInternalNumber}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button Content="编辑" 
                                                Command="{Binding DataContext.EditParticipantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditButtonStyle}" 
                                                Margin="0,0,8,0"/>
                                        <Button Content="删除" 
                                                Command="{Binding DataContext.DeleteParticipantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态提示 -->
                <TextBlock Grid.Row="1"
                           Text="请选择上方分组查看详情" 
                           FontSize="14" Foreground="{StaticResource SecondaryTextColorBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedRaceGroup, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
            </Grid>
        </Border>
        </Grid>

        <!-- 加载遮罩层 -->
        <Border Background="#80000000" 
                Panel.ZIndex="1000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="32,24"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="处理中..." 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextColorBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请稍候" 
                               FontSize="12" 
                               Foreground="{StaticResource SecondaryTextColorBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
