<Window x:Class="Timer.Views.ImportParticipantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入参赛人员"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选择项目 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Text="项目名称：" 
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextColorBrush}"/>
            <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedProject}"
                      Height="36"
                      VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding ProjectDate, StringFormat=yyyy-MM-dd}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- 选择文件 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Text="选择文件：" 
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextColorBrush}"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding SelectedFileName, Mode=OneWay}" 
                     Height="36"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="4,0,0,0"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="浏览..."
                    Command="{Binding SelectFileCommand}"
                    Width="80"
                    Height="36"/>
        </Grid>

        <!-- 导入进度 -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar Value="{Binding ImportProgress}" 
                         Maximum="100" 
                         Height="8"
                         Background="{StaticResource BorderColorBrush}"
                         Foreground="{StaticResource PrimaryColorBrush}"/>
        </Grid>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="取消" 
                    Command="{Binding CancelCommand}"
                    Width="80" 
                    Height="36"
                    Margin="0,0,12,0"/>
            <Button Content="确认导入" 
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="100" 
                    Height="36"/>
        </StackPanel>
    </Grid>
</Window>
